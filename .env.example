# ScholarMind runs directly on the local machine. Copy this file to .env.

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
WEB_HOST=127.0.0.1
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Authentication is optional for a loopback-only local workspace.
AUTH_REQUIRED=false
API_BEARER_TOKEN=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Local persistence — no external database, queue, object store, or vector service required.
DATABASE_URL=sqlite+aiosqlite:///./data/scholarmind.db
QUEUE_MODE=inline
AUTO_CREATE_SCHEMA=true
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/objects
RETRIEVAL_BACKEND=database
PAPER_RETENTION_DAYS=90
WORKER_METRICS_PORT=0

# OpenAI-compatible chat completions.
# BASE_URL is the API root (normally ending in /v1); ScholarMind appends /chat/completions.
# Leave all three empty to use the offline grounded gateway.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
MAX_CONTEXT_CHARACTERS=24000

# OpenAI-compatible embeddings.
# BASE_URL is the API root (normally ending in /v1); ScholarMind appends /embeddings.
# Leave all three empty to use deterministic local hash embeddings.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Used only by the offline local hash embedding implementation; remote dimensions are inferred.
EMBEDDING_DIMENSION=384

# arXiv search and ingestion safety
ARXIV_USER_AGENT=ScholarMind/0.1 (mailto:admin@example.com)
ARXIV_SEARCH_MIN_INTERVAL_SECONDS=3
# Includes the first attempt; retry only transient transport/408/429/5xx failures.
ARXIV_SEARCH_MAX_ATTEMPTS=3
# Per-attempt deadline and total budget including queueing/backoff, respectively.
ARXIV_SEARCH_ATTEMPT_TIMEOUT_SECONDS=20
ARXIV_SEARCH_TOTAL_TIMEOUT_SECONDS=65
RESEARCH_CACHE_TTL_SECONDS=21600
RESEARCH_MAX_CONTEXT_CHARACTERS=50000
# Paper briefing (TL;DR) context budget per paper.
SUMMARY_MAX_CONTEXT_CHARACTERS=24000
MAX_PDF_BYTES=52428800
MAX_PDF_PAGES=500
INGESTION_MAX_ATTEMPTS=3
DOWNLOAD_CONNECT_TIMEOUT_SECONDS=10
DOWNLOAD_READ_TIMEOUT_SECONDS=60
MAX_QUERY_CHARACTERS=4000

# Frontend server-side BFF only; never expose these as NEXT_PUBLIC_* variables.
API_INTERNAL_URL=http://127.0.0.1:8000
API_INTERNAL_BEARER_TOKEN=
